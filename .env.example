# Shape Express Environment Variables
# Copy this file to .env.local and fill in your actual values

# ============================================
# FIREBASE CONFIGURATION
# ============================================
# Get these from Firebase Console > Project Settings
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef1234567890

# ============================================
# STRIPE CONFIGURATION (for payments)
# ============================================
# Get these from Stripe Dashboard > API Keys
# Use test keys for development, live keys for production
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLIC_KEY=pk_test_your_public_key_here

# ============================================
# GOOGLE AI CONFIGURATION
# ============================================
# Get from Google Cloud Console - Required for Gemini AI API calls
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# SERVER CONFIGURATION
# ============================================
# The URL where this application is hosted
# Used for self-referential links, OAuth callbacks, and API endpoints
APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3000

# Session and security
SESSION_SECRET=session_secret_key_here

# ============================================
# OPTIONAL: FIREBASE ADMIN SDK
# ============================================
# For server-side Firebase operations (if using service account)
# FIREBASE_SERVICE_ACCOUNT_KEY=path_to_service_account.json

# ============================================
# OPTIONAL: DEVELOPMENT FLAGS
# ============================================
# Disable Hot Module Replacement in development (useful for some IDEs)
# DISABLE_HMR=true

# Enable verbose logging
# DEBUG=*
